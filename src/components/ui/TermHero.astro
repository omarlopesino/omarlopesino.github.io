---
import type { Image as TypeImage } from '@/types';
import ImageText from './ImageText.astro';
import PageTitle from './PageTitle.astro';

interface Props {
    type: 'tag' | 'category';
    name: string;
    description?: string;
    image?: TypeImage;
    class?: string;
}

const { type, name, description, image, class: className } = Astro.props;
---

<header class:list={['mb-8', className]}>
    <PageTitle class="mb-4">
        {type === 'tag' && <span class="opacity-40">#</span>}{name}
    </PageTitle>
    {
        image
            ? <ImageText image={image} text={description} />
            : <p class="text-lg/relaxed">{description}</p>
    }
</header>
