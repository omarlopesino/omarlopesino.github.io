---
import type { PostsListProps } from '@/types';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PostTeaser from './PostTeaser.astro';

interface Props extends PostsListProps {
}

const { title, class: className, posts = [], itemClass = "", imageClass = "", ...rest } = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));

---

<div class="rounded-box max-w-full p-4">
    <!-- Post titles below are h3s, so this h2 keeps the heading order unbroken even where no
         visible section title is given. -->
    <h2 class:list={['text-center font-display font-bold text-lg mb-2', !title && 'sr-only']}>{title ?? t('posts.listTitle')}</h2>
    <div class:list={[className, "md:justify-center"]} {...rest}>
        {
            posts.map((post) => (
                <PostTeaser class={itemClass} imageClass={imageClass} {...post} />
            ))
        }
    </div>
</div>
