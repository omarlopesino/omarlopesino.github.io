---
import { Image } from 'astro:assets';
import type { Image as Logo } from '@/types';
import Card from './Card.astro';
import DateInterval from './DateInterval.astro';

interface Props {
    title: string;
    organization: string;
    startDate: string;
    endDate: string;
    summary?: string;
    highlights?: string[];
    image?: Logo;
    imageClass?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    title,
    organization,
    startDate,
    endDate,
    summary,
    highlights = [],
    image,
    // A logo, not a cover: contained and small enough to leave the title the loudest thing.
    imageClass = 'mt-6 h-12 w-auto object-contain',
    class: className,
    ...rest
} = Astro.props;
---

<Card tag="article" title={title} class={className} {...rest}>
    <Fragment slot="image">
        {
            image && (
                <Image
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    class:list={[imageClass]}
                />
            )
        }
    </Fragment>
    <div slot="content" class="flex flex-col gap-3">
        <div class="flex flex-col opacity-70">
            <span>{organization}</span>
            <DateInterval date_a={startDate} date_b={endDate} />
        </div>
        {summary && <p>{summary}</p>}
        {
            highlights.length > 0 && (
                <ul class="list-disc ps-5 flex flex-col gap-1">
                    {highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
            )
        }
    </div>
</Card>
