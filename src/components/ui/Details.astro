---
interface Props {
  title?: string,
  description?: string,
  class?: string;
  [key: string]: unknown;
}

const { class: className, title, description, ...rest } = Astro.props;

---
<details class:list={[className, "collapse group bg-base-100 border border-base-300 collapse-arrow"]} {...rest}>
  <summary class="flex justify-between items-center collapse-title font-semibold">
    {Astro.slots.has('title') ? <slot name="title" /> : title}
  </summary>
  <div class="collapse-content text-sm">
    {Astro.slots.has('default') ? <slot /> : description}
  </div>
</details>
