---
interface Props {
  // Only where the block is not already under a heading of its own.
  title?: string;
  facets: {
    title: string;
    path: string;
    count?: number;
  }[],
  class?: string;
  [key: string]: unknown;
}

const { class: className, title, facets, ...rest } = Astro.props;

---

<div class:list={[className, 'flex flex-col gap-2']} {...rest}>
    {title && <h3 class="text-md font-bold">{title}</h3>}
    <ul class="ml-4 list-disc">
        {
            facets.map((facet) => (
                <li><a class="link link-hover" href={facet.path} title={facet.title}>{facet.title}{facet.count ? ` (${facet.count})` : ''}</a></li>
            ))
        }
    </ul>
</div>
