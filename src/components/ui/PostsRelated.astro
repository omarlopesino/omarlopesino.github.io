---
import { Image } from 'astro:assets';
import type { PostsListProps } from '@/types';
import Card from './Card.astro';
import Date from './Date.astro';

interface Props extends PostsListProps {
}

const { title, posts = [], class: className, itemClass, ...rest } = Astro.props;
---

<section class:list={['flex flex-col gap-4', className]} {...rest}>
    {title && <h2 class="m-0 text-xl font-bold tracking-tight">{title}</h2>}
    <div class="flex flex-col gap-4">
        {
            posts.map((post) => (
                <Card tag="article" url={post.url} title={post.title} class:list={['w-full', itemClass]}>
                    <Image
                        slot="image"
                        src={post.image.src}
                        alt={post.image.alt}
                        width={post.image.width}
                        height={post.image.height}
                        class="h-36 w-full object-cover"
                    />
                    {/* The card title already covers the whole card with an overlay link, so the
                        category is plain text here rather than PostCategory's anchor. */}
                    <div slot="content" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-meta text-base-content/60">
                        <Date date={post.pubDate} class="text-meta" />
                        {post.category && <span class="font-semibold text-primary">{post.category.name}</span>}
                    </div>
                </Card>
            ))
        }
    </div>
</section>
