---
import { Image } from 'astro:assets';
import Card from './Card.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { PostInterface } from '@/types';
import PostCategory from './PostCategory.astro';
import Date from './Date.astro';

interface Props extends PostInterface {
    // The one teaser likely above the fold on first load — skip lazy-loading so it can be the LCP.
    priority?: boolean;
}

const { class: className, imageClass, title, description, url, pubDate, image, category, tags, priority = false, ...rest } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<Card url={url} tag="article" title={title} class:list={[className]} {...rest}>
    <Image
        slot="image"
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        class={imageClass}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
    />
    <div slot="content" class="flex gap-3 py-2">
        <Date date={pubDate} />
        <PostCategory {...category} />
    </div>
    <p slot="content">{description}</p>
</Card>
