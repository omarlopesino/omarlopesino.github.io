---
import DateInterval from './DateInterval.astro';
import Details from './Details.astro';

interface Props {
    title: string;
    organization: string;
    startDate: string;
    endDate: string;
    summary?: string;
    highlights?: string[];
    class?: string;
    [key: string]: unknown;
}

const {
    title,
    organization,
    startDate,
    endDate,
    summary,
    highlights = [],
    class: className,
    ...rest
} = Astro.props;
---

<Details class={className} {...rest}>
    <div slot="title" class="flex flex-col md:flex-row md:items-baseline md:gap-6 w-full font-normal">
        <span class="font-semibold">{title}</span>
        <span class="opacity-70">{organization}</span>
        <DateInterval date_a={startDate} date_b={endDate} class="md:ms-auto opacity-70" />
    </div>
    {summary && <p>{summary}</p>}
    {
        highlights.length > 0 && (
            <ul class="list-disc ps-5 mt-2 flex flex-col gap-1">
                {highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
        )
    }
</Details>
