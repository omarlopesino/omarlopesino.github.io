---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, useUrl } from '@/i18n/utils';
import { type PostInterface } from '@/types';
import Breadcrumb from './Breadcrumb.astro';
import GridList from './GridList.astro';
import PostMeta from './PostMeta.astro';
import PostTags from './PostTags.astro';
import Share from './Share.astro';
import Toc from './Toc.astro';
import WebIntro from './WebIntro.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localizedUrl = useUrl(lang);

interface Props extends PostInterface {
    headings?: MarkdownHeading[];
    readingTime?: number;
    recommended?: PostInterface[];
}

const {
    class: className,
    category,
    title,
    description,
    url,
    pubDate,
    image,
    tags = [],
    headings = [],
    readingTime,
    recommended = [],
    ...rest
} = Astro.props;

const shareId = `share_${crypto.randomUUID()}`;

const trail = [
    { label: t('nav.blog'), href: localizedUrl(t('blog.path')) },
    { label: category.name, href: localizedUrl(t('category.path') + '/' + category.slug) },
    { label: title },
];
---

<div class:list={['flex flex-col', className]} {...rest}>
    <article class="mx-auto flex w-full max-w-prose flex-col gap-6">
        <Breadcrumb items={trail} />
        <h1 class="text-display m-0">{title}</h1>
        <p class="text-lede m-0 border-l-[3px] border-accent pl-4 text-base-content/70">{description}</p>
        <div class="flex flex-col gap-3">
            <div class="h-px bg-base-300"></div>
            <PostMeta pubDate={pubDate} category={category} readingTime={readingTime} />
        </div>
        <Image
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            class="w-full aspect-[16/9] rounded-box object-cover"
        />
        <Toc headings={headings} />
        <div class="prose max-w-none">
            <slot name="content" />
        </div>
        <div class="mt-2 h-px bg-base-300"></div>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <PostTags tags={tags} />
            <Share
                id={shareId}
                label={t('post.shareTitle')}
                url={url}
                title={title}
                text={description}
                class="self-start shrink-0"
            />
        </div>
        <WebIntro
            class="rounded-box bg-base-200 p-5"
            text={t('post.authorBio')}
            image={{ src: '/200x200.jpg', alt: 'Omar Lopesino', width: 200, height: 200 }}
        />
    </article>
    {recommended.length > 0 && <GridList class="mt-10" title={t('post.recommended')} posts={recommended} />}
</div>
