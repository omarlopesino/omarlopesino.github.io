---
import { Icon } from 'astro-icon/components';
import type { PostInterface } from '@/types';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Date from './Date.astro';
import PostCategory from './PostCategory.astro';

interface Props {
    pubDate: PostInterface['pubDate'];
    category: PostInterface['category'];
    readingTime?: number;
    class?: string;
    [key: string]: unknown;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { pubDate, category, readingTime, class: className, ...rest } = Astro.props;
---

<div class:list={['flex flex-wrap items-center gap-x-4 gap-y-2 text-meta font-mono text-base-content/60', className]} {...rest}>
    <span class="inline-flex items-center gap-1.5">
        <Icon name="mdi:calendar-blank-outline" class="w-4 h-4" aria-hidden="true" />
        <Date date={pubDate} class="text-meta" />
    </span>
    <PostCategory {...category} />
    {
        readingTime && (
            <span class="inline-flex items-center gap-1.5">
                <Icon name="mdi:clock-outline" class="w-4 h-4" aria-hidden="true" />
                {t('post.readingTime').replace('{n}', String(readingTime))}
            </span>
        )
    }
</div>
