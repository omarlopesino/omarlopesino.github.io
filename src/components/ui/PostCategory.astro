---
import { Icon } from 'astro-icon/components';
import type { Term } from '@/types';
import { getLangFromUrl, useTranslations, useUrl } from '@/i18n/utils';

interface Props extends Term {
    class?: string;
    [key: string]: unknown;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localizedUrl = useUrl(lang);

const { class: className, name, slug, cid, language, description, image, ...rest } = Astro.props;
---

<a
    href={localizedUrl(t('category.path') + '/' + slug)}
    class:list={['inline-flex items-center gap-1.5 font-mono font-semibold text-primary link link-hover', className]}
    {...rest}
><Icon name="mdi:folder-outline" class="w-4 h-4" aria-hidden="true" />{name}</a>
