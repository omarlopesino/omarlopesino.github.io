---
import type { Term } from '@/types';
import { getLangFromUrl, useTranslations, useUrl } from '@/i18n/utils';
import BubbleList from './BubbleList.astro';

interface Props {
    tags: Term[];
    class?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localizedUrl = useUrl(lang);

const { tags, class: className } = Astro.props;

const items = tags.map((tag) => ({
    label: tag.name,
    href: localizedUrl(t('tag.path') + '/' + tag.slug),
}));
---

<BubbleList items={items} ariaLabel={t('post.tagsLabel')} class={className} />
