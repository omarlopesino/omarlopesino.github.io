---
import type { Image as TypeImage } from '@/types';
import { coverSrcSet } from '@/lib/images';

interface Props {
  image: TypeImage,
  class?: string;
  [key: string]: unknown;
}

const { class: className, image, ...rest } = Astro.props;

---

<div class="avatar">
    <div class:list={[className]} {...rest}>
        <img
            src={image.src}
            srcset={coverSrcSet(image.src)}
            sizes="4rem"
            alt={image.alt}
            height={image.height}
            width={image.width}
            decoding="async"
        />
    </div>
</div>
