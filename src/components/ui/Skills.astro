---
import DefinitionTable from './DefinitionTable.astro';
import Tab from './Tab.astro';
import Tabs from './Tabs.astro';

interface Props {
    groups: {
        id: string,
        label: string,
        items: { name: string, description: string }[],
    }[];
    panelClass?: string;
    class?: string;
    [key: string]: unknown;
}

// Two thirds by default, the width the descriptions read best at; a narrow container passes its own.
const { groups, panelClass = 'md:w-2/3 mx-auto pt-3', class: className, ...rest } = Astro.props;

// One radio group per instance, so two Skills on a page don't steal each other's selection.
const group = 'skills-' + crypto.randomUUID();
---

<Tabs class={className} {...rest}>
    {
        groups.map((skillGroup, index) => (
            <Tab group={group} label={skillGroup.label} checked={index === 0} panelClass={panelClass}>
                {/* The badge classes rather than a bold term: a skill is a highlight that must not
                    read as clickable, which is what the accent chip says. */}
                <DefinitionTable items={skillGroup.items} termClass="badge badge-accent badge-sm" />
            </Tab>
        ))
    }
</Tabs>
