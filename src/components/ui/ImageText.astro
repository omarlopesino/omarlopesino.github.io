---
import { Image } from 'astro:assets';
import type { Image as TypeImage } from '@/types';

interface Props {
    image: TypeImage;
    text?: string;
    // 'mobile' stacks below md only (the wide teaser default), 'always' stacks at every width
    // (the about page's tall portrait), 'never' stays side-by-side even on mobile (the compact
    // homepage avatar, where stacking would push the intro below the fold).
    stack?: 'mobile' | 'always' | 'never';
    class?: string;
    imageClass?: string;
    textClass?: string;
}

// The defaults are the wide teaser shape; a caller wanting another scale — a round avatar, say —
// overrides them instead of getting its own component.
const {
    image,
    text,
    stack = 'mobile',
    class: className,
    imageClass = 'w-full md:w-1/3 rounded-box aspect-[16/9] object-cover',
    textClass = 'md:w-2/3 text-lg/relaxed',
} = Astro.props;

const stackClass = { mobile: 'max-md:flex-col', always: 'flex-col', never: '' }[stack];
---

<div class:list={['flex', stackClass, 'md:items-center', 'gap-4 md:gap-6', className]}>
    {/* Both callers (AboutLayout, TermHero) put this at the top of the page, so it's the likely LCP. */}
    <Image src={image.src} alt={image.alt} width={image.width} height={image.height} class:list={[imageClass]} loading="eager" fetchpriority="high" />
    <div class:list={[textClass]}>{Astro.slots.has('default') ? <slot /> : text}</div>
</div>
