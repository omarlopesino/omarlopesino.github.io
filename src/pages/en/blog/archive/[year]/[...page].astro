---
import type { Page } from 'astro';
import { useTranslations } from '@/i18n/utils';
import { getYearAlternateUrls, pageAlternates, yearPaths } from '@/lib/blog';
import type { PostInterface } from '@/types';
import { collectionLd, pageContext } from '@/lib/seo';
import PostsListLayout from '@/layouts/PostsListLayout.astro';

interface Props {
  page: Page<PostInterface>;
}

export const getStaticPaths = yearPaths('en');

const { year } = Astro.params;
const { page } = Astro.props;

const t = useTranslations('en');

const heading = `${t('year.postsTitle')} ${year}`;

const alternates = pageAlternates(getYearAlternateUrls(year!), page.currentPage);
const meta = { jsonLd: [collectionLd('CollectionPage', pageContext(Astro, heading, heading, 'en', alternates))] };
---

<PostsListLayout
    title={heading}
    description={heading}
    lang="en"
    alternates={alternates}
    page={page}
    meta={meta}
/>
