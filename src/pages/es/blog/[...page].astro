---
import type { Page } from 'astro';
import { getAlternates } from '@/i18n/routes';
import { blogPaths, pageAlternates } from '@/lib/blog';
import type { PostInterface } from '@/types';
import BlogLayout from '@/layouts/BlogLayout.astro';

interface Props {
  page: Page<PostInterface>;
}

export const getStaticPaths = blogPaths('es');

const { page } = Astro.props;
---

<BlogLayout
    title="Omar Lopesino"
    heading="Blog"
    description="Web personal de Omar Lopesino donde puedes leer sus posts y más acerca de el."
    lang="es"
    alternates={pageAlternates(getAlternates('blog'), page.currentPage)}
    page={page}
/>
