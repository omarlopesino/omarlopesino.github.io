---
import { render, type CollectionEntry } from 'astro:content';
import type { Alternate } from '@/i18n/routes';
import { getContentAlternateUrls, getPostCategory, getPostTags, getRecommendedPosts } from '@/lib/blog';
import { readingTime } from '@/lib/utils';
import Post from '../components/ui/Post.astro';
import Layout from './Layout.astro';

interface Props {
	entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

// Rendering here rather than in the page keeps the headings, which only render() returns.
const { Content, headings } = await render(entry);

const tags = await getPostTags(entry);
const category = await getPostCategory(entry);
const recommended = await getRecommendedPosts(entry);
const alternates : Alternate[] = await getContentAlternateUrls('blog', entry.data);
---

<Layout title={entry.data.title} description={entry.data.description} lang={entry.data.language} alternates={alternates}>
	<Post
        title={entry.data.title}
        description={entry.data.description}
        category={category}
        pubDate={entry.data.pubDate}
        image={entry.data.image}
        tags={tags}
        url={entry.data.url}
        headings={headings}
        readingTime={readingTime(entry.body ?? '')}
        recommended={recommended}
    >
        <Content slot="content" />
    </Post>
</Layout>
