---
import type { Page } from 'astro';
import type { Alternate } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import type { PostInterface } from '@/types';
import GridList from '@/components/ui/GridList.astro';
import PageTitle from '@/components/ui/PageTitle.astro';
import Pagination from '@/components/ui/Pagination.astro';
import Layout from './Layout.astro';

interface Props {
    title: string;
    heading?: string;
    listTitle?: string;
    description?: string;
    lang: 'en' | 'es';
    alternates?: Alternate[];
    page: Page<PostInterface>;
}

// The heading falls back to the document title; the front page sets its own so the browser tab
// keeps the site name while the page leads with 'Blog'. A listing that brings its own header —
// a term hero — fills the header slot instead and uses neither.
const { title, heading = title, listTitle, description, lang, alternates = [], page } = Astro.props;

const t = useTranslations(lang);
---

<Layout title={title} description={description} lang={lang} alternates={alternates}>
    <slot name="header">
        <PageTitle>{heading}</PageTitle>
    </slot>
    <slot name="intro" />
    {
        page.data.length > 0
            ? <GridList featured title={listTitle} posts={page.data} />
            : <p class="text-center text-sm opacity-70 py-12">{t('posts.empty')}</p>
    }
    <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
    />
</Layout>
