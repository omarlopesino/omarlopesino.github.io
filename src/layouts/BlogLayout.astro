---
import type { Page } from 'astro';
import type { Alternate } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { avatar } from '@/lib/profile';
import type { PostInterface } from '@/types';
import WebIntro from '@/components/ui/WebIntro.astro';
import PostsListLayout from './PostsListLayout.astro';

interface Props {
    title: string;
    heading?: string;
    description?: string;
    lang: 'en' | 'es';
    alternates?: Alternate[];
    page: Page<PostInterface>;
}

const { title, heading, description, lang, alternates = [], page } = Astro.props;

const t = useTranslations(lang);
---

<PostsListLayout title={title} heading={heading} description={description} lang={lang} alternates={alternates} page={page}>
    {/* The same introduction the about-me page leads with, at the size of a byline. The Fragment
        keeps `slot` off WebIntro, which would forward it into the DOM as an attribute. */}
    <Fragment slot="intro">
        <WebIntro text={t('about.intro')} image={avatar} />
    </Fragment>
</PostsListLayout>
