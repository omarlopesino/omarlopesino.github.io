---
import type { Page } from 'astro';
import { getCollection } from 'astro:content';
import type { Alternate } from '@/i18n/routes';
import { useTranslations, useUrl } from '@/i18n/utils';
import { avatar } from '@/lib/profile';
import { collectionLd, pageContext } from '@/lib/seo';
import type { PostInterface } from '@/types';
import BubbleList from '@/components/ui/BubbleList.astro';
import WebIntro from '@/components/ui/WebIntro.astro';
import PostsListLayout from './PostsListLayout.astro';

interface Props {
    title: string;
    heading?: string;
    description?: string;
    lang: 'en' | 'es';
    alternates?: Alternate[];
    page: Page<PostInterface>;
}

const { title, heading, description, lang, alternates = [], page } = Astro.props;

const t = useTranslations(lang);
const localizedUrl = useUrl(lang);

// Every subject the blog holds, as the way into each one: the tags have no index page of their own.
const meta = { jsonLd: [collectionLd('Blog', pageContext(Astro, title, description, lang, alternates))] };

const tags = (await getCollection('tag', ({data}) => data.language == lang))
    .sort((a, b) => a.data.name.localeCompare(b.data.name, lang))
    .map(({data}) => ({
        label: `#${data.name}`,
        href: localizedUrl(t('tag.path') + '/' + data.slug),
    }));
---

<PostsListLayout title={title} heading={heading} description={description} lang={lang} alternates={alternates} page={page} meta={meta}>
    {/* The same introduction the about-me page leads with, at the size of a byline. */}
    <div slot="intro" class="flex flex-col gap-4">
        <WebIntro text={t('about.intro')} image={avatar} />
        <BubbleList items={tags} ariaLabel={t('tag.title')} bubbleClass="badge-accent badge-lg font-medium no-underline" />
    </div>
</PostsListLayout>
