---
import { getCollection } from 'astro:content';
import type { Alternate } from '@/i18n/routes';
import { useTranslations, useUrl } from '@/i18n/utils';
import { getYears } from '@/lib/blog';
import BubbleList from '@/components/ui/BubbleList.astro';
import PageTitle from '@/components/ui/PageTitle.astro';
import Layout from './Layout.astro';

// The index of one way of grouping posts. Years have no collection behind them, so they are read
// off the posts themselves; everything else about the page is the same.
interface Props {
  type: 'tag' | 'category' | 'year';
  lang: 'en' | 'es';
  alternates: Alternate[];
}

const { type, lang, alternates } = Astro.props;

const t = useTranslations(lang);
const localizedUrl = useUrl(lang);

const title = t(`${type}.title`);
const description = t(`${type}.description`);
const termUrl = (slug: string | number) => localizedUrl(t(`${type}.path`) + '/' + slug);

const items = type === 'year'
  ? (await getYears(lang)).map(({year}) => ({ label: String(year), href: termUrl(year) }))
  : (await getCollection(type, ({data}) => data.language == lang))
      .sort((a, b) => a.data.name.localeCompare(b.data.name, lang))
      .map(({data}) => ({
        label: type === 'tag' ? `#${data.name}` : data.name,
        href: termUrl(data.slug),
      }));
---

<Layout title={title} description={description} lang={lang} alternates={alternates}>
    <PageTitle>{title}</PageTitle>
    <p class="text-lede text-center max-w-prose mx-auto">{description}</p>
    <BubbleList items={items} ariaLabel={title} class="justify-center" bubbleClass="badge-accent badge-lg font-medium no-underline" />
</Layout>
