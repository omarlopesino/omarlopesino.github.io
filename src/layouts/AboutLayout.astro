---
import { getCollection } from 'astro:content';
import type { Alternate } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { avatar } from '@/lib/profile';
import DefinitionTable from '@/components/ui/DefinitionTable.astro';
import ImageText from '@/components/ui/ImageText.astro';
import Section from '@/components/ui/Section.astro';
import Layout from './Layout.astro';

interface Props {
    title: string;
    description?: string;
    lang: 'en' | 'es';
    alternates?: Alternate[];
}

const { title, description, lang, alternates = [] } = Astro.props;

const t = useTranslations(lang);

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const inLang = (entry: { data: { language: string } }) => entry.data.language === lang;

const abilities = (await getCollection('ability', inLang)).sort(byOrder);

// English in both languages, so a link to a section is the same fragment on either page.
const anchors = { abilities: 'abilities' };

const linkedin = 'https://www.linkedin.com/in/omar-mohamad-el-hassan-lopesino-ba639462/';

const tableClass = 'md:w-2/3 mx-auto';
---

{/* The page leads with the pitch rather than a title, so the site name in the header is its h1. */}
<Layout title={title} description={description} lang={lang} alternates={alternates} logoTag="h1" sidebar={false}>
    {/* Stacked on a phone, the avatar and the pitch centre on each other; beside each other from
        md up they read better ranged left. */}
    <ImageText
        class="max-md:items-center max-md:text-center"
        image={avatar}
        text={t('about.intro')}
        imageClass="w-32 shrink-0 rounded-full aspect-square object-cover"
        textClass="text-lede"
    />

    <Section id={anchors.abilities} title={t('about.abilities')}>
        <DefinitionTable
            items={abilities.map(({ data }) => ({ name: data.name, description: data.description }))}
            class={tableClass}
        />
    </Section>

    {/* The brand name stays out of the translations: it is the same word in both languages and the
        one the link hangs on. */}
    <p class="text-base text-center text-base-content/70">
        {t('about.linkedin')} <a class="link link-hover" href={linkedin} target="_blank" rel="noopener noreferrer">Linkedin</a>
    </p>
</Layout>
