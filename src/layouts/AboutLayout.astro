---
import { getCollection } from 'astro:content';
import type { Alternate } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import IconCardLink from '@/components/ui/IconCardLink.astro';
import ImageText from '@/components/ui/ImageText.astro';
import Section from '@/components/ui/Section.astro';
import Skills from '@/components/ui/Skills.astro';
import Table from '@/components/ui/Table.astro';
import RecordCard from '@/components/ui/RecordCard.astro';
import Layout from './Layout.astro';

interface Props {
    title: string;
    description?: string;
    lang: 'en' | 'es';
    alternates?: Alternate[];
}

const { title, description, lang, alternates = [] } = Astro.props;

const t = useTranslations(lang);

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const inLang = (entry: { data: { language: string } }) => entry.data.language === lang;

const experience = (await getCollection('experience', inLang)).sort(byOrder);
const education = (await getCollection('education', inLang)).sort(byOrder);
const skills = (await getCollection('skill', inLang)).sort(byOrder);
const spokenLanguages = (await getCollection('spokenLanguage', inLang)).sort(byOrder);

// A declared order, so the tabs never reshuffle when a skill is added or a group empties.
const groupIds = ['backend', 'frontend', 'data', 'devops', 'practice'] as const;
const skillGroups = groupIds
    .map((id) => ({
        id,
        label: t(`skill.group.${id}`),
        items: skills
            .filter((skill) => skill.data.group === id)
            .map(({ data }) => ({ name: data.name, description: data.description })),
    }))
    .filter((group) => group.items.length > 0);

const languageRows = spokenLanguages.map(({ data }) => ({ head: data.name, cells: [data.level] }));

// The timeline shows years; an entry with no end date is still current.
const year = (date?: string) => date ? date.slice(0, 4) : t('about.present');

const avatar = { src: '/200x200.jpg', alt: 'Omar Lopesino', width: 200, height: 200 };

// English in both languages, so the calls to action are plain fragments that need no translation.
const anchors = { work: 'work', studies: 'studies', skills: 'skills' };

const tableClass = 'md:w-2/3 mx-auto';
---

<Layout title={title} description={description} lang={lang} alternates={alternates}>
    <ImageText
        image={avatar}
        text={t('about.intro')}
        imageClass="w-32 shrink-0 rounded-full aspect-square object-cover"
        textClass="text-lede"
    />

    <div class="grid gap-4 my-10 md:grid-cols-3">
        <IconCardLink icon="mdi:briefcase-outline" label={t('about.ctaWork')} href={`#${anchors.work}`} />
        <IconCardLink icon="mdi:school-outline" label={t('about.ctaStudies')} href={`#${anchors.studies}`} />
        <IconCardLink icon="mdi:tools" label={t('about.ctaSkills')} href={`#${anchors.skills}`} />
    </div>

    <Section id={anchors.work} title={t('about.work')} intro={t('about.workIntro')}>
        {
            experience.map(({ data }) => (
                <RecordCard
                    title={data.title}
                    organization={data.organization}
                    startDate={year(data.startDate)}
                    endDate={year(data.endDate)}
                    summary={data.summary}
                    highlights={data.highlights}
                />
            ))
        }
    </Section>

    <Section id={anchors.studies} title={t('about.studies')} intro={t('about.studiesIntro')}>
        {
            education.map(({ data }) => (
                <RecordCard
                    title={data.title}
                    organization={data.organization}
                    startDate={year(data.startDate)}
                    endDate={year(data.endDate)}
                    summary={data.summary}
                    highlights={data.highlights}
                />
            ))
        }
    </Section>

    <Section id={anchors.skills} title={t('about.skills')} intro={t('about.skillsIntro')}>
        <Skills groups={skillGroups} />
    </Section>

    <Section title={t('about.languages')}>
        <Table rows={languageRows} class={tableClass} />
    </Section>
</Layout>
