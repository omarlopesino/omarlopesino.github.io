---
import { getCollection } from 'astro:content';
import type { Alternate } from '@/i18n/routes';
import { useTranslations, useUrl } from '@/i18n/utils';
import { avatar } from '@/lib/profile';
import { getLangPosts, getTermPosts } from '@/lib/blog';
import { pageContext, personLd } from '@/lib/seo';
import { Icon } from 'astro-icon/components';
import BubbleList from '@/components/ui/BubbleList.astro';
import CategoryCard from '@/components/ui/CategoryCard.astro';
import GridList from '@/components/ui/GridList.astro';
import ImageText from '@/components/ui/ImageText.astro';
import Layout from './Layout.astro';

interface Props {
    title: string;
    description?: string;
    lang: 'en' | 'es';
    alternates?: Alternate[];
}

const { title, description, lang, alternates = [] } = Astro.props;

const t = useTranslations(lang);
const localizedUrl = useUrl(lang);

const meta = {
    type: 'profile' as const,
    image: avatar,
    jsonLd: [personLd(pageContext(Astro, title, t('home.intro'), lang, alternates))],
};

const recentPosts = (await getLangPosts(lang)).slice(0, 6);

const categories = await Promise.all(
    (await getCollection('category', ({ data }) => data.language == lang))
        .sort((a, b) => a.data.name.localeCompare(b.data.name, lang))
        .map(async ({ data }) => ({
            name: data.name,
            description: data.description,
            image: data.image,
            href: localizedUrl(t('category.path') + '/' + data.slug),
            count: (await getTermPosts('category', { cid: data.cid, language: lang })).length,
        })),
);

const tags = (await getCollection('tag', ({ data }) => data.language == lang))
    .sort((a, b) => a.data.name.localeCompare(b.data.name, lang))
    .map(({ data }) => ({
        label: `#${data.name}`,
        href: localizedUrl(t('tag.path') + '/' + data.slug),
    }));
---

{/* The tagline leads instead of a title, so the site name in the header is its h1. */}
<Layout title={title} description={description} lang={lang} alternates={alternates} logoTag="h1" meta={meta}>
    <ImageText
        image={avatar}
        text={t('home.intro')}
        class="items-center max-w-prose mx-auto"
        imageClass="w-12 h-12 shrink-0 rounded-full aspect-square object-cover"
        textClass="text-sm"
    />

    {categories.length > 0 && (
        <div>
            <h2 class="mb-2 text-center font-display text-lg font-bold">{t('category.title')}</h2>
            {categories.length > 3 ? (
                <div class="carousel carousel-center gap-3 p-1">
                    {categories.map((category) => <CategoryCard {...category} class="carousel-item w-40 sm:w-44" />)}
                </div>
            ) : (
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
                    {categories.map((category) => <CategoryCard {...category} />)}
                </div>
            )}
        </div>
    )}

    {tags.length > 0 && <BubbleList class="w-full max-w-prose mx-auto justify-center" items={tags} ariaLabel={t('tag.title')} />}

    {recentPosts.length > 0 && (
        <div>
            <GridList
                title={t('home.recentPosts')}
                posts={recentPosts}
                imageClass="max-md:h-36 max-md:w-full max-md:object-cover"
            />
            <div class="flex justify-end">
                <a
                    href={localizedUrl(t('blog.path'))}
                    class="link link-hover font-mono text-sm inline-flex items-center gap-1"
                >
                    {t('home.viewAllPosts')}
                    <Icon name="mdi:arrow-right" class="w-4 h-4" aria-hidden="true" />
                </a>
            </div>
        </div>
    )}
</Layout>
